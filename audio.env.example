# Copy to audio.env (which is gitignored) and set to your own sound card.
#
# Find it with:   aplay -L | grep -A1 CARD=
# Use the hw: form, not plughw: or default: -- hw: is direct hardware access
# with no resampling layer, which is what keeps latency low.
#
# Only this one setting differs between machines, which is why it is not in
# the tracked service file.
ALSA_DEVICE=hw:CARD=Device,DEV=0
