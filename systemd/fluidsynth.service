[Unit]
Description=FluidSynth soundfont engine (headless piano module)
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=$USER
Group=audio
SupplementaryGroups=audio

# systemd services do not read /etc/security/limits.conf, so realtime
# privileges must be granted here as well.
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=2

# The soundfont is held resident in RAM. Never let any of it be swapped out,
# even under memory pressure -- faulting a page back mid-note is exactly the
# kind of stall that causes an audible dropout.
MemorySwapMax=0

# The sound card name is the one thing here that differs between machines, so
# it lives outside this file. Create audio.env from audio.env.example (it is
# gitignored) and this unit stays identical everywhere, which means pulling an
# update never conflicts with a local edit. See README step 4.
#
# A missing audio.env fails the unit with a clear message, which is better than
# silently starting on the wrong device.
EnvironmentFile=/home/$USER/piano-synth/audio.env

ExecStart=/usr/bin/fluidsynth -is \
  -a alsa \
  -o audio.alsa.device=${ALSA_DEVICE} \
  -o audio.period-size=128 \
  -o audio.periods=2 \
  -o audio.realtime-prio=90 \
  -o synth.sample-rate=48000 \
  -o synth.polyphony=256 \
  -o synth.cpu-cores=3 \
  -m alsa_seq \
  -o midi.autoconnect=1 \
  -o shell.port=9800 \
  -g 0.3 \
  -C 0 \
  -R 1

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
