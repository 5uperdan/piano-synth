[Unit]
Description=Sense HAT control surface for FluidSynth
After=fluidsynth.service
Requires=fluidsynth.service

[Service]
Type=simple
User=$USER
Group=$USER
SupplementaryGroups=i2c gpio input spi

WorkingDirectory=/home/$USER/piano-synth
Environment=PIANO_CONFIG=/home/$USER/piano-synth/config.toml
ExecStart=/home/$USER/piano-synth/.venv/bin/python /home/$USER/piano-synth/piano_control.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
